{
  "version": 1,
  "project": "thedelegator",
  "defaultBranch": "main",
  "worktreeRoot": "..",
  "shared": {
    "owner": "antigravity",
    "reason": "Touched by almost every task. One owner prevents a conflict on every merge. This is an agent name, not a role: the orchestrator reads it to find the architect.",
    "paths": [
      "package.json",
      "**/package.json",
      "Dockerfile",
      ".github/workflows/**",
      ".gitignore"
    ]
  },
  "agents": {
    "antigravity": {
      "role": "architect",
      "branch": "feat/antigravity",
      "owns": [
        "lib/**",
        "templates/**"
      ],
      "title": "Antigravity IDE",
      "color": "purple",
      "icon": "🔮"
    },
    "claude": {
      "role": "builder",
      "branch": "main",
      "owns": [
        "bin/**",
        "README.md",
        "CONNECT.md"
      ],
      "title": "Claude — CLI and docs",
      "color": "orange",
      "icon": "◈"
    }
  },
  "everyoneMayWrite": [
    "claims/${agent}.md"
  ],
  "checks": {
    "verify": "npm test",
    "staleAfterHours": 12
  }
}
