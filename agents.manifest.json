{
  "version": 1,
  "project": "thedelegator",
  "defaultBranch": "main",
  "worktreeRoot": "..",
  "shared": {
    "owner": "architect",
    "reason": "Touched by almost every task. One owner prevents a conflict on every merge.",
    "paths": [
      "package.json",
      "**/package.json",
      "Dockerfile",
      ".github/workflows/**",
      ".gitignore"
    ]
  },
  "agents": {
    "antigravity": {
      "role": "architect",
      "branch": "feat/antigravity",
      "owns": [
        "lib/**",
        "templates/**",
        "app/**"
      ],
      "title": "Antigravity IDE",
      "color": "purple",
      "icon": "🔮"
    },
    "claude": {
      "role": "architect",
      "branch": "main",
      "owns": [
        "taskplan.md",
        "docs/**",
        "HANDOFF.md"
      ],
      "title": "claude IDE Agent",
      "color": "blue",
      "icon": "🤖"
    }
  },
  "everyoneMayWrite": [
    "claims/${agent}.md"
  ],
  "checks": {
    "verify": "npm test",
    "staleAfterHours": 12
  }
}