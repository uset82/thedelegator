{
  "name": "thedelegator",
  "version": "0.3.0",
  "description": "Coordination-free parallelism for multiple AI coding agents. Disjoint lanes, enforced by CI. Status derived from git, never self-reported.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uset82/thedelegator.git"
  },
  "homepage": "https://github.com/uset82/thedelegator#readme",
  "bugs": {
    "url": "https://github.com/uset82/thedelegator/issues"
  },
  "author": "Carlos Carpio (https://github.com/uset82)",
  "bin": {
    "delegator": "bin/delegator.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/lanes.test.mjs test/tools.test.mjs && node test/manifests.check.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "orchestration",
    "codeowners",
    "git-worktree",
    "claude",
    "codex",
    "cursor",
    "gemini"
  ]
}
